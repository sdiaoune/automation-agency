---
interface Props {
  variant?: "landing" | "blog";
}

const serviceLinks = [
  { label: "Services", href: "/services/" },
  { label: "Use Cases", href: "/use-cases/" },
  { label: "Integrations", href: "/integrations/" },
  { label: "Consultation", href: "/book-demo/" },
];

const resourceLinks = [
  { label: "Resources", href: "/resources/" },
  { label: "Workflow Audit", href: "/resources/missed-call-workflow-audit/" },
  { label: "ROI Calculator", href: "/resources/missed-call-recovery-roi-calculator/" },
  { label: "Comparisons", href: "/compare/" },
  { label: "Customers", href: "/customers/" },
  { label: "Blog", href: "/blog/" },
];

const companyLinks = [
  { label: "About", href: "/about/" },
  { label: "Links", href: "/links/" },
  { label: "Security", href: "/security/" },
];

const legalLinks = [
  { label: "Privacy", href: "/privacy/" },
  { label: "Terms", href: "/terms/" },
  { label: "SMS Consent", href: "/sms-consent/" },
];

const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/emc2ops/" },
  { label: "YouTube", href: "https://www.youtube.com/@EMC2Ops" },
  { label: "X", href: "https://x.com/EMC2Ops" },
  { label: "Instagram", href: "https://www.instagram.com/emc2ops_official/" },
];
---

<footer class="site-footer">
  <div class="wrap footer-shell">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="EMC2Ops home">
        <span class="mark">E²</span>
        <span>EMC2Ops</span>
      </a>
      <p>AI front desk workflows for property managers.</p>
      <span>© 2026 EMC2Ops. All rights reserved.</span>
    </div>

    <nav class="footer-group" aria-label="Services links">
      <strong>Services</strong>
      {serviceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <nav class="footer-group" aria-label="Resource links">
      <strong>Resources</strong>
      {resourceLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <nav class="footer-group" aria-label="Company links">
      <strong>Company</strong>
      {companyLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      {socialLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <nav class="footer-group" aria-label="Legal links">
      <strong>Legal</strong>
      {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>
