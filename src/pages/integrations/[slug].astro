---
import FaqList from "../../components/FaqList.astro";
import BeforeAfterBlock from "../../components/BeforeAfterBlock.astro";
import FitBlock from "../../components/FitBlock.astro";
import InstallablesBlock from "../../components/InstallablesBlock.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkflowAuditCta from "../../components/WorkflowAuditCta.astro";
import ProductScreenshot from "../../components/ProductScreenshot.astro";
import { auditHref } from "../../lib/conversion";
import { absoluteUrl, defaultSocialImage } from "../../lib/site";
import {
  integrationPages,
  integrationSchema,
  integrationUrl,
  type IntegrationPage,
} from "../../lib/integrations";
import { productScreenshotForPath } from "../../lib/productScreenshots";
import "../../styles/service.css";

export async function getStaticPaths() {
  return integrationPages.map((integration) => ({
    params: { slug: integration.slug },
    props: { integration },
  }));
}

interface Props {
  integration: IntegrationPage;
}

const { integration } = Astro.props;
const canonical = absoluteUrl(integrationUrl(integration));
const auditUrl = auditHref(integration.slug, "integration");
const productScreenshot = productScreenshotForPath(`/integrations/${integration.slug}/`);
---

<SiteLayout
  title={`${integration.seoTitle} | EMC2Ops`}
  description={integration.description}
  canonical={canonical}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt={`${integration.name} automation workflows from EMC2Ops.`}
  schema={integrationSchema(integration)}
  pageClass="service-page"
>
  <SiteHeader />
  <main>
    <section class="service-hero">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/integrations/">Integrations</a><span>/</span>{integration.name}
        </nav>
        <img class="hero-logo" src={integration.logo} alt={`${integration.name} logo`} width="54" height="54" />
        <p class="eyebrow">{integration.name}</p>
        <h1>{integration.title}</h1>
        <p class="dek">{integration.summary}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={auditUrl}>{integration.auditCta.label}</a>
          <a class="btn btn-secondary" href="/services/">View services</a>
        </div>
      </div>
    </section>

    <section class="product-proof-section">
      <div class="wrap">
        <ProductScreenshot screenshot={productScreenshot} />
      </div>
    </section>

    <section class="wrap split-section">
      <div>
        <h2>What can connect</h2>
        <p>{integration.auditFocus}</p>
      </div>
      <div class="check-list">
        {integration.supportedWorkflows.map((workflow) => <div><span>✓</span><p>{workflow}</p></div>)}
      </div>
    </section>

    <section class="wrap detail-section">
      <h2>Useful workflows</h2>
      <ol class="step-list">
        {integration.workflows.map((workflow) => <li>{workflow}</li>)}
      </ol>
    </section>

    <InstallablesBlock items={integration.installables} intro="Integration work starts by choosing the safest connection path for the workflow: API, middleware, inbox or form parsing, review queue, or a hybrid route." />

    <section class="wrap split-section">
      <div>
        <h2>API and access caveats</h2>
        <div class="check-list">
          {integration.accessNotes.map((note) => <div><span>✓</span><p>{note}</p></div>)}
        </div>
      </div>
      <div>
        <h2>Fallback paths</h2>
        <div class="check-list">
          {integration.fallbackPaths.map((path) => <div><span>✓</span><p>{path}</p></div>)}
        </div>
      </div>
    </section>

    <WorkflowAuditCta
      title={integration.auditCta.title}
      body={integration.auditCta.body}
      href={auditUrl}
      label={integration.auditCta.label}
      secondaryHref="#prep"
      secondaryLabel="See prep list"
    />

    <BeforeAfterBlock before={integration.beforeAfter.before} after={integration.beforeAfter.after} />

    <section id="prep" class="wrap detail-section">
      <h2>Audit prep checklist</h2>
      <div class="check-list">
        {integration.auditPrep.map((item) => <div><span>✓</span><p>{item}</p></div>)}
      </div>
    </section>

    <FitBlock bestFit={integration.bestFit} notFit={integration.notFit} />

    <section class="wrap split-section">
      <div>
        <h2>Related services</h2>
        <div class="related-links stacked-links">
          {integration.relatedServices.map((link) => (
            <a href={link.href}>
              <strong>{link.label}</strong>
              <span>Service page</span>
            </a>
          ))}
        </div>
      </div>
      <div>
        <h2>Related use cases</h2>
        <div class="related-links stacked-links">
          {integration.relatedUseCases.map((link) => (
            <a href={link.href}>
              <strong>{link.label}</strong>
              <span>Use-case page</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="wrap detail-section">
      <FaqList faqs={integration.faqs} />
    </section>

    <WorkflowAuditCta
      eyebrow="Next step"
      title={`Map your ${integration.name} workflow`}
      body="Use the audit to confirm the connection path, required fields, fallback route, review gates, and first workflow to deploy."
      href={auditUrl}
      label={integration.auditCta.label}
    />
  </main>
  <SiteFooter />
</SiteLayout>
