---
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  formTitle?: string;
  workflow?: string;
  source?: string;
  agendaItems?: string[];
  proofItems?: string[];
}

const {
  eyebrow = "15-minute consultation",
  title = "Use the call for a quote, demo, or workflow audit.",
  body = "Choose the outcome you need. We’ll review your current setup, answer questions, and recommend a practical next step.",
  formTitle = "Book your 15-minute consultation.",
  workflow = "",
  source = "",
  agendaItems = [
    "Tell us whether you need pricing, a demo, or help choosing the first workflow.",
    "Review the current bottleneck and the tools your team already uses.",
    "Leave with a clear next step and tailored scope when there is a fit.",
  ],
  proofItems = [
    "Missed-call text-back",
    "Leasing follow-up",
    "Maintenance triage",
    "CRM cleanup",
  ],
} = Astro.props;
---

<section id="book-demo" class="booking-section">
  <div class="wrap">
    <div class="booking">
      <div class="booking-panel">
        <div class="eyebrow">{eyebrow}</div>
        <h2>{title}</h2>
        <p class="muted">{body}</p>

        <div class="audit-agenda" aria-label="Consultation agenda">
          <strong>What happens on the call</strong>
          <ol>
            {agendaItems.map((item) => <li>{item}</li>)}
          </ol>
        </div>

        <div class="proof-strip" aria-label="Workflow examples">
          {proofItems.map((item) => <span>{item}</span>)}
        </div>

        <ul>
          <li>No generic AI pitch</li>
          <li>Built around your existing tools</li>
          <li>One practical implementation path</li>
        </ul>
      </div>

      <div class="calendar-box">
        <form class="audit-form" id="audit-form" data-workflow={workflow} data-source={source}>
          <strong>{formTitle}</strong>
          <p class="muted">Choose a time below. Every opening is shown in your local timezone.</p>
          <p class="booking-step" id="booking-step">Step 1 of 2: choose a time that works.</p>
          <p class="booking-context" id="booking-context" hidden></p>

          <div class="slot-picker" id="slot-picker" aria-live="polite">
            <div class="slot-picker-head">
              <span>Next openings</span>
              <small id="calendar-timezone">Detecting your local time…</small>
            </div>
            <div class="slot-grid" id="slot-grid">
              <p class="slot-loading">Loading available consultation times...</p>
            </div>
            <p class="slot-fallback">
              Can’t find a workable time?
              <a href="mailto:soya@getemc2ops.com?subject=Consultation%20alternate%20times">Ask for alternate options</a>.
            </p>
          </div>

          <input name="scheduledStart" id="scheduled-start" type="hidden" required />
          <input name="scheduledEnd" id="scheduled-end" type="hidden" />
          <input name="scheduledLabel" id="scheduled-label" type="hidden" />
          <input name="scheduledTimeZone" id="scheduled-time-zone" type="hidden" value="America/New_York" />
          <input name="workflowContext" id="workflow-context" type="hidden" />
          <input name="sourceContext" id="source-context" type="hidden" />

          <div class="booking-details-panel" id="booking-details-panel" hidden>
            <div class="selected-slot-summary" id="selected-slot-summary" hidden>
              <span>Selected time</span>
              <strong id="selected-slot-label"></strong>
            </div>

            <div class="form-grid" id="booking-details">
              <label>
                Name
                <input name="fullName" autocomplete="name" required />
              </label>
              <label>
                Work email
                <input name="email" type="email" autocomplete="email" required />
              </label>
              <label>
                Company
                <input name="company" autocomplete="organization" required />
              </label>
              <label>
                Biggest workflow problem
                <select name="workflowProblem" required>
                  <option value="">Select one</option>
                  <option>Missed leasing calls</option>
                  <option>Tenant intake</option>
                  <option>Maintenance triage</option>
                  <option>CRM follow-up</option>
                  <option>Owner or vendor updates</option>
                </select>
              </label>
            </div>

            <details class="prep-fields">
              <summary>Optional prep details</summary>
              <div class="form-grid">
                <label>
                  Phone
                  <input name="phone" type="tel" autocomplete="tel" />
                </label>
                <label>
                  Company website
                  <input name="companyWebsite" type="url" inputmode="url" placeholder="https://example.com" />
                </label>
                <label>
                  Portfolio size
                  <select name="portfolioSize">
                    <option value="">Select one</option>
                    <option>1-50 units</option>
                    <option>51-250 units</option>
                    <option>251-1,000 units</option>
                    <option>1,000+ units</option>
                  </select>
                </label>
                <label class="full-field">
                  What should we look at first?
                  <textarea name="message" placeholder="Example: after-hours calls are missed, leads are not followed up, maintenance requests need better routing..."></textarea>
                </label>
              </div>
            </details>

            <label class="hidden-field">
              Leave this blank
              <input name="companySiteConfirm" tabindex="-1" autocomplete="off" />
            </label>

            <div class="form-actions">
              <button class="btn btn-primary" type="submit">Book My Consultation</button>
              <p class="form-note">You’ll get a direct confirmation from EMC2Ops.</p>
            </div>
          </div>
          <p class="form-status" id="audit-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const auditForm = document.querySelector("#audit-form");
  const auditFormStatus = document.querySelector("#audit-form-status");
  const slotGrid = document.querySelector("#slot-grid");
  const scheduledStart = document.querySelector("#scheduled-start");
  const scheduledEnd = document.querySelector("#scheduled-end");
  const scheduledLabel = document.querySelector("#scheduled-label");
  const scheduledTimeZone = document.querySelector("#scheduled-time-zone");
  const workflowContext = document.querySelector("#workflow-context");
  const sourceContext = document.querySelector("#source-context");
  const bookingStep = document.querySelector("#booking-step");
  const bookingContext = document.querySelector("#booking-context");
  const calendarTimeZone = document.querySelector("#calendar-timezone");
  const bookingDetailsPanel = document.querySelector("#booking-details-panel");
  const selectedSlotSummary = document.querySelector("#selected-slot-summary");
  const selectedSlotLabel = document.querySelector("#selected-slot-label");
  const workflowProblemSelect = auditForm?.querySelector("[name='workflowProblem']");
  const bookingParams = new URLSearchParams(window.location.search);
  const requestedWorkflow = bookingParams.get("workflow") || auditForm?.dataset.workflow || "";
  const requestedSource = bookingParams.get("source") || auditForm?.dataset.source || "";
  const visitorTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";
  const INITIAL_VISIBLE_SLOT_COUNT = 8;
  const SLOT_BATCH_SIZE = 8;
  let loadedSlots = [];
  let visibleSlotCount = INITIAL_VISIBLE_SLOT_COUNT;
  let formStarted = false;

  const workflowContextMap = {
    "missed-call-recovery": { label: "Missed-call recovery", problem: "Missed leasing calls" },
    "leasing-follow-up": { label: "Leasing follow-up automation", problem: "CRM follow-up" },
    "maintenance-intake-automation": { label: "Maintenance intake automation", problem: "Maintenance triage" },
    "crm-workflow-automation": { label: "CRM workflow automation", problem: "CRM follow-up" },
    "owner-update-automation": { label: "Owner update automation", problem: "Owner or vendor updates" },
    "vendor-dispatch-automation": { label: "Vendor dispatch automation", problem: "Owner or vendor updates" },
    "ai-front-desk-property-management": { label: "AI front desk for property management", problem: "Missed leasing calls" },
    "apartment-lead-tracking": { label: "Apartment lead tracking", problem: "CRM follow-up" },
    "real-estate-lead-follow-up-automation": { label: "Real estate lead follow-up automation", problem: "CRM follow-up" },
    "how-to-automate-property-management": { label: "Property management workflow automation", problem: "CRM follow-up" },
    "lead-to-lease-automation": { label: "Lead-to-lease automation", problem: "CRM follow-up" },
    "real-estate-crm-follow-up-mess": { label: "CRM follow-up cleanup", problem: "CRM follow-up" },
    "leasing-intake-routing-automation": { label: "Leasing intake and routing automation", problem: "CRM follow-up" },
    "resident-owner-vendor-communication-automation": { label: "Resident, owner, and vendor communication automation", problem: "Owner or vendor updates" },
    appfolio: { label: "AppFolio automation", problem: "CRM follow-up" },
    buildium: { label: "Buildium integration", problem: "CRM follow-up" },
    leadsimple: { label: "LeadSimple automation", problem: "CRM follow-up" },
  };

  function workflowLabelFromSlug(slug) {
    return slug
      .split("-")
      .filter(Boolean)
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(" ");
  }

  function applyBookingContext() {
    if (!requestedWorkflow) return;

    const context = workflowContextMap[requestedWorkflow] || {
      label: workflowLabelFromSlug(requestedWorkflow),
      problem: "",
    };

    if (workflowProblemSelect && context.problem) {
      workflowProblemSelect.value = context.problem;
    }

    if (workflowContext) {
      workflowContext.value = requestedWorkflow;
    }

    if (sourceContext) {
      sourceContext.value = requestedSource;
    }

    if (bookingContext) {
      bookingContext.hidden = false;
      bookingContext.textContent = `We’ll focus first on ${context.label}.`;
    }
  }

  function bookingEvent(name, params = {}) {
    const googleTag = window.gtag || (typeof gtag === "function" ? gtag : null);

    if (typeof googleTag === "function") {
      googleTag("event", name, params);
    }

    if (typeof window.va === "function") {
      window.va("event", { name, data: params });
    }
  }

  function gtag_report_conversion(url) {
    const callback = function () {
      if (typeof url !== "undefined") {
        window.location = url;
      }
    };

    const googleTag = window.gtag || (typeof gtag === "function" ? gtag : null);

    if (typeof googleTag === "function") {
      googleTag("event", "conversion", {
        send_to: "AW-18196518863/zkVCCLy6ncQcEM-v4-RD",
        event_callback: callback
      });
    } else {
      callback();
    }

    return false;
  }

  window.gtag_report_conversion = gtag_report_conversion;
  applyBookingContext();
  bookingEvent("booking_page_view", {
    page_path: window.location.pathname,
    workflow: requestedWorkflow,
    source: requestedSource,
    display_time_zone: visitorTimeZone
  });

  if (calendarTimeZone) {
    calendarTimeZone.textContent = `Your local time · ${visitorTimeZone}`;
  }

  function slotDayLabel(slot) {
    const start = new Date(slot.start);

    if (!Number.isNaN(start.getTime())) {
      return new Intl.DateTimeFormat("en-US", {
        day: "numeric",
        month: "long",
        timeZone: visitorTimeZone,
        weekday: "long",
      }).format(start);
    }

    return slot.day || "Available times";
  }

  function groupSlots(slots) {
    return slots.reduce((groups, slot) => {
      const day = slotDayLabel(slot);
      const existing = groups.find((group) => group.day === day);
      if (existing) {
        existing.slots.push(slot);
      } else {
        groups.push({ day, slots: [slot] });
      }
      return groups;
    }, []);
  }

  function slotStartLabel(slot) {
    const start = new Date(slot.start);

    if (!Number.isNaN(start.getTime())) {
      return new Intl.DateTimeFormat("en-US", {
        hour: "numeric",
        minute: "2-digit",
        timeZone: visitorTimeZone,
      }).format(start);
    }

    return (slot.timeLabel || slot.label || "Select time").split(" - ")[0];
  }

  function selectedSlotDisplayLabel(slot) {
    const start = new Date(slot.start);
    const end = new Date(slot.end);

    if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) {
      return slot.label || "Selected time";
    }

    const day = new Intl.DateTimeFormat("en-US", {
      day: "numeric",
      month: "short",
      timeZone: visitorTimeZone,
      weekday: "short",
    }).format(start);
    const startTime = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: visitorTimeZone,
    }).format(start);
    const endTime = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: visitorTimeZone,
    }).format(end);

    return `${day}, ${startTime} – ${endTime} (${visitorTimeZone})`;
  }

  function resetBookingStep() {
    if (bookingStep) {
      bookingStep.textContent = "Step 1 of 2: choose a time that works.";
    }
  }

  function selectSlot(button, slot) {
    const displayLabel = selectedSlotDisplayLabel(slot);

    slotGrid?.querySelectorAll(".slot-button").forEach((slotButton) => {
      slotButton.classList.remove("selected");
      slotButton.setAttribute("aria-pressed", "false");
    });

    button.classList.add("selected");
    button.setAttribute("aria-pressed", "true");
    scheduledStart.value = slot.start;
    scheduledEnd.value = slot.end;
    scheduledLabel.value = slot.label;
    scheduledTimeZone.value = slot.timeZone || "America/New_York";
    bookingDetailsPanel.hidden = false;
    selectedSlotSummary.hidden = false;
    selectedSlotLabel.textContent = displayLabel;
    if (bookingStep) {
      bookingStep.textContent = "Step 2 of 2: add details to confirm.";
    }
    auditForm.classList.add("slot-selected");
    auditFormStatus.textContent = `Time selected: ${displayLabel}. Last step: add your details.`;
    auditFormStatus.className = "form-status";
    bookingEvent("calendar_slot_selected", {
      slot_start: slot.start,
      slot_label: slot.label,
      display_time_zone: visitorTimeZone
    });

    window.requestAnimationFrame(() => {
      selectedSlotSummary?.scrollIntoView({ behavior: "smooth", block: "start" });
      window.setTimeout(() => {
        auditForm.querySelector("[name='fullName']")?.focus({ preventScroll: true });
      }, 320);
    });
  }

  function renderSlots(slots) {
    if (!slotGrid) return;

    if (!slots.length) {
      slotGrid.innerHTML = '<p class="slot-loading">No open consultation times are available right now. Email soya@getemc2ops.com and we will send options manually.</p>';
      return;
    }

    slotGrid.innerHTML = "";
    const visibleSlots = slots.slice(0, visibleSlotCount);

    for (const group of groupSlots(visibleSlots)) {
      const groupElement = document.createElement("div");
      groupElement.className = "slot-day";

      const title = document.createElement("strong");
      title.textContent = group.day;
      groupElement.append(title);

      const list = document.createElement("div");
      list.className = "slot-list";

      for (const slot of group.slots) {
        const displayLabel = selectedSlotDisplayLabel(slot);
        const button = document.createElement("button");
        button.className = "slot-button";
        button.type = "button";
        button.setAttribute("aria-pressed", "false");
        button.setAttribute("aria-label", `Select ${displayLabel}`);
        button.title = displayLabel;
        button.textContent = slotStartLabel(slot);

        if (slot.start === scheduledStart.value) {
          button.classList.add("selected");
          button.setAttribute("aria-pressed", "true");
        }

        button.addEventListener("click", () => selectSlot(button, slot));
        list.append(button);
      }

      groupElement.append(list);
      slotGrid.append(groupElement);
    }

    if (visibleSlotCount < slots.length) {
      const moreButton = document.createElement("button");
      const remaining = slots.length - visibleSlotCount;
      moreButton.className = "slot-more-button";
      moreButton.type = "button";
      moreButton.textContent = `Show more times (${remaining} more)`;
      moreButton.addEventListener("click", () => {
        visibleSlotCount += SLOT_BATCH_SIZE;
        renderSlots(loadedSlots);
        bookingEvent("calendar_more_times_opened", {
          visible_slots: Math.min(visibleSlotCount, loadedSlots.length),
          total_slots: loadedSlots.length
        });
      });
      slotGrid.append(moreButton);
    }
  }

  async function loadSlots() {
    if (!slotGrid) return;

    try {
      const response = await fetch("/api/audit-slots/");
      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(result.error || "Could not load available consultation times.");
      }

      loadedSlots = result.slots || [];
      visibleSlotCount = INITIAL_VISIBLE_SLOT_COUNT;
      renderSlots(loadedSlots);
    } catch (error) {
      slotGrid.innerHTML = '<p class="slot-loading">Available times could not load. Email soya@getemc2ops.com and we will send options manually.</p>';
      bookingEvent("form_error", { step: "slot_load", message: error.message || "Slot load failed" });
    }
  }

  auditForm?.addEventListener("input", () => {
    if (formStarted) return;
    formStarted = true;
    bookingEvent("form_start", { form: "workflow_audit" });
  });

  auditForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const submitButton = auditForm.querySelector("button[type='submit']");
    const formData = new FormData(auditForm);
    const payload = Object.fromEntries(formData.entries());
    payload.pageUrl = window.location.href;

    if (!payload.scheduledStart) {
      auditFormStatus.textContent = "Pick an available consultation time first.";
      auditFormStatus.className = "form-status error";
      bookingEvent("form_error", { step: "slot_required" });
      document.querySelector("#slot-picker")?.scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }

    auditFormStatus.textContent = "Booking your consultation...";
    auditFormStatus.className = "form-status";
    submitButton.disabled = true;

    try {
      const response = await fetch("/api/book-audit/", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(result.error || "We could not submit the request.");
      }

      auditForm.reset();
      slotGrid?.querySelectorAll(".slot-button").forEach((slotButton) => {
        slotButton.classList.remove("selected");
        slotButton.setAttribute("aria-pressed", "false");
      });
      selectedSlotSummary.hidden = true;
      selectedSlotLabel.textContent = "";
      bookingDetailsPanel.hidden = true;
      auditForm.classList.remove("slot-selected");
      resetBookingStep();
      auditFormStatus.textContent = "Consultation booked. We’ll send a direct confirmation shortly.";
      auditFormStatus.className = "form-status success";
      bookingEvent("booking_confirmed", { booking_id: result.id, slot_start: payload.scheduledStart });
      loadSlots();

      window.gtag_report_conversion();
    } catch (error) {
      auditFormStatus.textContent = error.message || "Something went wrong. Please try again in a moment.";
      auditFormStatus.className = "form-status error";
      bookingEvent("form_error", { step: "submit", message: error.message || "Submit failed" });
    } finally {
      submitButton.disabled = false;
    }
  });

  loadSlots();
</script>

<style>
  .booking-section {
    padding: 68px 0;
    scroll-margin-top: 78px;
  }

  .booking {
    align-items: stretch;
    display: grid;
    gap: 18px;
    grid-template-columns: .85fr 1.15fr;
  }

  .booking-panel,
  .calendar-box {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 24px;
  }

  .calendar-box {
    background:
      radial-gradient(circle at 100% 0, oklch(var(--brand-l) var(--brand-c) var(--brand-h) / .09), transparent 24rem),
      var(--card);
    min-height: 400px;
  }

  .calendar-box > form > strong {
    display: block;
    font-size: 1.35rem;
    margin-bottom: 8px;
  }

  .muted,
  .booking-panel li {
    color: var(--muted);
  }

  .booking-panel ul {
    display: grid;
    gap: 10px;
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
  }

  .booking-panel li::before {
    color: var(--primary);
    content: "\2713";
    font-weight: 900;
    margin-right: 8px;
  }

  .audit-agenda {
    background: var(--muted-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: 22px 0 0;
    padding: 18px;
  }

  .audit-agenda strong {
    display: block;
    margin-bottom: 10px;
  }

  .audit-agenda ol {
    color: var(--muted);
    margin: 0;
    padding-left: 20px;
  }

  .audit-agenda li {
    margin: 0 0 8px;
  }

  .audit-agenda li::before {
    content: none;
  }

  .proof-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
  }

  .proof-strip span {
    background: var(--accent-soft);
    border: 1px solid oklch(var(--brand-l) var(--brand-c) var(--brand-h) / .18);
    border-radius: 999px;
    color: var(--primary);
    font-size: .84rem;
    font-weight: 760;
    padding: 8px 10px;
  }

  .audit-form,
  .booking-details-panel {
    display: grid;
    gap: 14px;
    text-align: left;
  }

  .booking-details-panel[hidden] {
    display: none;
  }

  .booking-step {
    color: var(--primary);
    font-size: .9rem;
    font-weight: 850;
    margin: 0;
  }

  .booking-context,
  .selected-slot-summary {
    background: var(--accent-soft);
    border: 1px solid oklch(var(--brand-l) var(--brand-c) var(--brand-h) / .22);
    border-radius: var(--radius);
    color: var(--accent-soft-foreground);
    padding: 12px 14px;
  }

  .booking-context {
    font-weight: 720;
    margin: 0;
  }

  .slot-picker {
    background: var(--muted-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: grid;
    gap: 12px;
    padding: 16px;
  }

  .slot-picker-head {
    align-items: center;
    display: flex;
    gap: 12px;
    justify-content: space-between;
  }

  .slot-picker-head span,
  #book-demo :global(.slot-day strong) {
    font-weight: 850;
  }

  .slot-picker-head small,
  #book-demo :global(.slot-loading),
  .slot-fallback {
    color: var(--muted);
    font-weight: 700;
  }

  .slot-picker-head small {
    text-align: right;
  }

  .slot-grid,
  #book-demo :global(.slot-day) {
    display: grid;
    gap: 12px;
  }

  #book-demo :global(.slot-list) {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  #book-demo :global(.slot-button),
  #book-demo :global(.slot-more-button) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    font: inherit;
    font-size: .88rem;
    font-weight: 800;
    min-height: 44px;
    padding: 10px;
    text-align: center;
    transition: background .18s ease, border-color .18s ease, box-shadow .18s ease, color .18s ease;
    white-space: nowrap;
  }

  #book-demo :global(.slot-button) {
    background: var(--card);
    color: var(--foreground);
  }

  #book-demo :global(.slot-more-button) {
    background: var(--accent-soft);
    color: var(--primary);
  }

  #book-demo :global(.slot-button:hover),
  #book-demo :global(.slot-button:focus-visible),
  #book-demo :global(.slot-more-button:hover),
  #book-demo :global(.slot-more-button:focus-visible) {
    border-color: var(--primary);
    box-shadow: var(--focus-ring);
    outline: none;
  }

  #book-demo :global(.slot-button.selected) {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }

  .slot-fallback {
    font-size: .9rem;
    margin: 0;
  }

  .slot-fallback a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .selected-slot-summary {
