---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import ClientReviews from "../components/ClientReviews.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import { homepageBuyerFaqs, homepageSetupFaqs } from "../lib/homepageFaq";
import { productScreenshotForPath } from "../lib/productScreenshots";
import { absoluteUrl, defaultSocialImage, homeSchema } from "../lib/site";
import "../styles/landing.css";

const title = "EMC2Ops | Missed Leasing Call Recovery for Property Managers";
const description = "EMC2Ops installs missed leasing call recovery workflows for property managers: instant SMS text-back, renter qualification, routing, and CRM logging.";
const productScreenshot = productScreenshotForPath("/");
---

<SiteLayout
  title={title}
  description={description}
  canonical={absoluteUrl("/")}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="EMC2Ops property management automation workflow for capturing after-hours leasing leads."
  schema={homeSchema()}
  author="EMC2Ops"
>
  <SiteHeader variant="landing" />
<main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <div class="eyebrow">Missed leasing call recovery for property managers</div>
          <h1>Turn missed leasing calls into text-back, qualification, and routed next steps.</h1>
          <p class="lead">EMC2Ops installs one measurable workflow first: when a renter call is missed after hours, during tours, or while the team is busy, they get an immediate SMS path and your team gets a clean summary.</p>
          <div class="hero-actions">
            <a href="/book-demo/" class="btn btn-primary">Book a 15-minute consultation</a>
            <a href="#demo" class="btn btn-secondary">Watch the Demo</a>
          </div>
        </div>

        <div class="dashboard product-hero-media">
          <ProductScreenshot screenshot={productScreenshot} variant="hero" priority useDesktopOnMobile />
        </div>

        <div class="offer-strip" aria-label="Core EMC2Ops services">
          <div class="offer-chip"><span class="icon">01</span><div><strong>Immediate text-back</strong><span>Missed callers get a branded SMS in seconds</span></div></div>
          <div class="offer-chip"><span class="icon">02</span><div><strong>Renter qualification</strong><span>Move timing, property fit, budget, pets, and intent captured</span></div></div>
          <div class="offer-chip"><span class="icon">03</span><div><strong>Team and CRM routing</strong><span>Showing requests, transcripts, summaries, and tasks sent to the right place</span></div></div>
        </div>
        <div class="proof">
          <span><i class="dot"></i> Built around your current phone/SMS and CRM stack</span>
          <span><i class="dot"></i> Scoped around one measurable first workflow</span>
          <span><i class="dot"></i> Human handoff stays in the team’s control</span>
        </div>
      </div>
    </section>

    <aside class="customer-results" aria-label="Customer operating scale">
      <dl class="wrap customer-results-list">
        <div class="customer-result">
          <dt>3,000+</dt>
          <dd>Units served <span>Across 200+ properties</span></dd>
        </div>
        <div class="customer-result">
          <dt>300+</dt>
          <dd>Security deposits processed per month</dd>
        </div>
        <div class="customer-result">
          <dt>500+</dt>
          <dd>Work order tickets processed per month</dd>
        </div>
      </dl>
    </aside>

    <section id="overview">
      <div class="wrap">
        <div class="section-head">
          <h2>What you are buying: an installed property management automation system.</h2>
          <p>We do the implementation work: workflow mapping, AI prompts, SMS and voice logic, CRM connections, appointment routing, reporting, testing, and post-launch optimization.</p>
        </div>

        <div class="cards">
          <article class="card">
            <span class="icon">1</span>
            <h3>AI front desk setup</h3>
            <p>We configure AI voice and SMS intake that answers common questions, collects renter details, handles missed calls, and escalates when a human should take over.</p>
          </article>

          <article class="card">
            <span class="icon">2</span>
            <h3>Workflow and routing buildout</h3>
            <p>We turn leasing, maintenance, owner, and vendor communication into clear workflows with the right questions, routing rules, notifications, and handoffs.</p>
          </article>

          <article class="card">
            <span class="icon">3</span>
            <h3>CRM and reporting integration</h3>
            <p>We connect calls, texts, appointments, summaries, tasks, tags, and pipeline updates to your existing tools so the team can see what happened next.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="integrations">
      <div class="wrap">
        <div class="section-head">
          <h2>Works with the systems your property team already uses.</h2>
          <p>We support the platforms property managers rely on for leasing, operations, CRM, and follow-up workflows.</p>
        </div>

        <div class="integration-grid" aria-label="Supported property management and CRM platforms">
          <div class="integration-logo">
            <img src="/assets/integrations/appfolio.png" alt="AppFolio logo" width="42" height="42" loading="lazy" />
            <span>AppFolio</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/buildium.png" alt="Buildium logo" width="42" height="42" loading="lazy" />
            <span>Buildium</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/leadsimple.png" alt="LeadSimple logo" width="42" height="42" loading="lazy" />
            <span>LeadSimple</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/yardi.png" alt="Yardi logo" width="42" height="42" loading="lazy" />
            <span>Yardi</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/rent-manager.png" alt="Rent Manager logo" width="42" height="42" loading="lazy" />
            <span>Rent Manager</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/entrata.png" alt="Entrata logo" width="42" height="42" loading="lazy" />
            <span>Entrata</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/knock.png" alt="Knock logo" width="42" height="42" loading="lazy" />
            <span>Knock</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/hubspot.png" alt="HubSpot logo" width="42" height="42" loading="lazy" />
            <span>HubSpot</span>
          </div>
          <div class="integration-logo">
            <img src="/assets/integrations/salesforce.png" alt="Salesforce logo" width="42" height="42" loading="lazy" />
            <span>Salesforce</span>
          </div>
        </div>
      </div>
    </section>

    <section id="pain">
      <div class="wrap">
        <div class="section-head">
          <h2>Built for the problems property teams feel every day.</h2>
          <p>Slow response times cost showings, tenant satisfaction, owner trust, and staff capacity. EMC2Ops targets the operational bottlenecks that leak revenue.</p>
        </div>

        <div class="pain-grid">
          <article class="pain-card">
            <strong>Missed leasing calls</strong>
            <p>Respond instantly when prospects call after hours, during tours, or while your team is overloaded.</p>
          </article>
          <article class="pain-card">
            <strong>Tenant maintenance requests</strong>
            <p>Collect issue details, photos, urgency, property/unit information, and route requests to the right person.</p>
          </article>
          <article class="pain-card">
            <strong>Owner updates</strong>
            <p>Send automated status updates so owners are not constantly asking your team for progress.</p>
          </article>
          <article class="pain-card">
            <strong>Vendor dispatching</strong>
            <p>Trigger technician notifications and collect completion updates without manual back-and-forth.</p>
          </article>
          <article class="pain-card">
            <strong>Stale lead follow-up</strong>
            <p>Automatically follow up with prospects who never booked, no-showed, or stopped replying.</p>
          </article>
          <article class="pain-card">
            <strong>Manual CRM updates</strong>
            <p>Log conversations, tags, statuses, tasks, and appointment details into your existing systems.</p>
          </article>
        </div>
