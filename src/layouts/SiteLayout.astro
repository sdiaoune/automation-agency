---
import Analytics from "@vercel/analytics/astro";
import SeoHead from "../components/SeoHead.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: "website" | "article";
  image: string;
  imageAlt: string;
  themeColor?: string;
  schema?: unknown;
  pageClass?: string;
  author?: string;
}

const {
  title,
  description,
  canonical,
  type = "website",
  image,
  imageAlt,
  themeColor,
  schema,
  pageClass = "",
  author,
} = Astro.props;

const enableAnalytics = process.env.VERCEL === "1" || import.meta.env.PUBLIC_ENABLE_VERCEL_ANALYTICS === "true";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      image={image}
      imageAlt={imageAlt}
      themeColor={themeColor}
      schema={schema}
      author={author}
    />
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18196518863"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18196518863');
    </script>
    {enableAnalytics && <Analytics />}
  </head>
  <body class={pageClass}>
    <slot />
  </body>
</html>
