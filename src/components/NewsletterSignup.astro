---
interface Props {
  title?: string;
  description?: string;
  source?: string;
}

const {
  title = "Get the next property management automation guide.",
  description = "Daily notes when new EMC2Ops guides publish. Unsubscribe anytime.",
  source = "website-newsletter",
} = Astro.props;
---

<section class="newsletter-signup" aria-label="Newsletter signup">
  <div>
    <p class="newsletter-kicker">Newsletter</p>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <form class="newsletter-signup-form">
    <label>
      Email
      <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
    </label>
    <input name="source" type="hidden" value={source} />
    <label class="newsletter-honeypot">
      Leave this blank
      <input name="websiteConfirm" tabindex="-1" autocomplete="off" />
    </label>
    <button class="newsletter-submit" type="submit">Subscribe</button>
    <p class="newsletter-status" role="status" aria-live="polite"></p>
  </form>
</section>

<script is:inline>
  document.querySelectorAll(".newsletter-signup-form").forEach((form) => {
    if (form.dataset.ready === "true") return;
    form.dataset.ready = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = form.querySelector("button[type='submit']");
      const status = form.querySelector(".newsletter-status");
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      payload.pageUrl = window.location.href;

      status.textContent = "Subscribing...";
      status.className = "newsletter-status";
      submitButton.disabled = true;

      try {
        const response = await fetch("/api/newsletter-subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || "We could not subscribe that email.");
        }

        form.reset();
        status.textContent = "Subscribed. You will get new guides when they publish.";
        status.className = "newsletter-status success";
      } catch (error) {
        status.textContent = error.message || "Something went wrong. Please try again in a moment.";
        status.className = "newsletter-status error";
      } finally {
        submitButton.disabled = false;
      }
    });
  });
</script>

<style>
  .newsletter-signup {
    align-items: center;
    background: rgba(255,255,255,.045);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 8px;
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 430px);
    padding: 24px;
  }

  .newsletter-kicker {
    color: #ffe49a;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  .newsletter-signup h2 {
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    line-height: 1.08;
    margin: 0 0 10px;
  }

  .newsletter-signup p {
    color: #b8bcae;
    margin: 0;
  }

  .newsletter-signup-form {
    align-items: end;
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr auto;
  }

  .newsletter-signup-form label {
    color: #f5f7fb;
    display: grid;
    font-size: .92rem;
    font-weight: 760;
    gap: 8px;
  }

  .newsletter-signup-form input {
    background: rgba(8,11,16,.62);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 8px;
    color: #f5f7fb;
    font: inherit;
    min-height: 48px;
    outline: none;
    padding: 12px 14px;
  }

  .newsletter-signup-form input:focus {
    border-color: rgba(247,201,72,.66);
    box-shadow: 0 0 0 4px rgba(247,201,72,.12);
  }

  .newsletter-submit {
    align-items: center;
    background: #f7c948;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #15100a;
    cursor: pointer;
    display: inline-flex;
    font: inherit;
    font-weight: 750;
    justify-content: center;
    min-height: 48px;
    padding: 0 18px;
  }

  .newsletter-submit:disabled {
    cursor: wait;
    opacity: .72;
  }

  .newsletter-honeypot {
    left: -9999px;
    opacity: 0;
    pointer-events: none;
    position: absolute;
  }

  .newsletter-status {
    font-size: .95rem;
    grid-column: 1 / -1;
    min-height: 22px;
  }

  .newsletter-status.success {
    color: #46e6b0;
  }

  .newsletter-status.error {
    color: #ff6b6b;
  }

  @media (max-width: 760px) {
    .newsletter-signup,
    .newsletter-signup-form {
      grid-template-columns: 1fr;
    }
  }
</style>
