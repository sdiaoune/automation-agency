---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { absoluteUrl, blogIndexSchema, byOrder, cities, defaultSocialImage } from "../../lib/site";
import "../../styles/blog.css";

const posts = byOrder(await getCollection("blog"));
const pillars = [...new Set(posts.map((post) => post.data.pillar))];
const title = "Property Management Automation Blog | EMC2Ops";
const description =
  "Practical SEO guides for property managers on missed-call recovery, leasing automation, maintenance intake, CRM workflows, owner updates, and SMS compliance.";
---

<SiteLayout
  title={title}
  description={description}
  canonical={absoluteUrl("/blog/")}
  type="website"
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="Property Management Automation Blog | EMC2Ops social preview from EMC2Ops."
  schema={blogIndexSchema(posts)}
  pageClass="blog-index"
>
  <SiteHeader />
  <main>
    <section class="blog-hero">
      <div class="wrap">
        <p class="eyebrow">Property management automation guides</p>
        <h1>Learn what to automate before you buy an AI front desk.</h1>
        <p class="dek">
          Practical guides on missed-call recovery, leasing follow-up, maintenance intake, owner
          updates, vendor routing, CRM workflow automation, and SMS compliance for property
          management teams.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/book-demo/">Book a 15-minute consultation</a>
          <a class="btn btn-secondary" href="#posts">Browse articles</a>
        </div>
      </div>
    </section>

    <section class="wrap programmatic">
      <h2>Use the guides to pick the first workflow.</h2>
      <p>
        If your team misses leasing calls, chases stale prospects, retypes CRM notes, or manually
        routes maintenance requests, start with the articles below. Each guide uses clean slugs,
        structured article data, FAQ schema, internal links, and city-aware language for
        high-growth rental markets including {cities}.
      </p>
    </section>

    <section class="wrap blog-newsletter">
      <NewsletterSignup
        title="Get new automation guides when they publish."
        description="A daily send only when EMC2Ops publishes new property management automation guides."
        source="blog-index-newsletter"
      />
    </section>

    <section id="posts" class="wrap blog-list">
      {
        pillars.map((pillar) => (
          <div class="pillar">
            <h2>{pillar}</h2>
            <div class="post-grid">
              {posts
                .filter((post) => post.data.pillar === pillar)
                .map((post) => <BlogCard post={post} />)}
            </div>
          </div>
        ))
      }
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
