---
import Analytics from "@vercel/analytics/astro";
import SalesChatbot from "../components/SalesChatbot.astro";
import "../styles/funnel.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
}

const { title, description, canonical } = Astro.props;
const enableAnalytics = process.env.VERCEL === "1" || import.meta.env.PUBLIC_ENABLE_VERCEL_ANALYTICS === "true";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="theme-color" content="#00132f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18196518863"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-18196518863');

      window.gtag_report_conversion = function(url) {
        const callback = function() {
          if (typeof url !== 'undefined') window.location = url;
        };

        gtag('event', 'conversion', {
          send_to: 'AW-18196518863/zkVCCLy6ncQcEM-v4-RD',
          event_callback: callback
        });

        return false;
      };
    </script>
    {enableAnalytics && <Analytics />}
  </head>
  <body>
    <slot />
    <SalesChatbot />
  </body>
</html>
