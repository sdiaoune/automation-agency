    <section id="newsletter">
      <div class="wrap">
        <div class="newsletter-band">
          <div>
            <div class="eyebrow">Newsletter</div>
            <h2>Get property management automation ideas in your inbox.</h2>
            <p>Short notes on missed-call recovery, leasing follow-up, tenant intake, CRM cleanup, and operational AI workflows.</p>
          </div>

          <form class="newsletter-form" id="newsletter-form">
            <label>
              Email
              <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
            </label>
            <input name="source" type="hidden" value="website-newsletter" />
            <label class="hidden-field">
              Leave this blank
              <input name="websiteConfirm" tabindex="-1" autocomplete="off" />
            </label>
            <button class="btn btn-primary" type="submit">Subscribe</button>
            <p class="form-status" id="newsletter-form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="wrap">
        <div class="section-head">
          <h2>Questions property managers ask before installing AI.</h2>
          <p>Clear answers on call handling, rollout effort, human handoff, fit, customization, alternatives, languages, pricing, integrations, and compliance.</p>
        </div>

        <div class="faq-grid buyer-faq-grid">
          {homepageBuyerFaqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>
                <span class="faq-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span>{faq.question}</span>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
                {faq.cta && <a class="faq-link" href={faq.cta.href}>{faq.cta.label} <span aria-hidden="true">→</span></a>}
              </div>
            </details>
          ))}
        </div>

        <div class="faq-secondary">
          <h3>More setup questions</h3>
          <div class="faq-grid setup-faq-grid">
            {homepageSetupFaqs.map((faq) => (
              <details class="faq-item compact">
                <summary><span>{faq.question}</span></summary>
                <div class="faq-answer"><p>{faq.answer}</p></div>
              </details>
            ))}
