  </main>

  <div class="mobile-sticky">
    <a href="/book-demo/" class="btn btn-primary">Book a 15-minute consultation</a>
  </div>

  <SiteFooter variant="landing" />
  <script is:inline>
    const newsletterForm = document.querySelector("#newsletter-form");
    const newsletterFormStatus = document.querySelector("#newsletter-form-status");
    const demoSection = document.querySelector("#demo");
    const updateStickyCta = () => {
      document.body.classList.toggle("sticky-visible", window.scrollY > 520);
    };

    updateStickyCta();
    window.addEventListener("scroll", updateStickyCta, { passive: true });

    if (demoSection && "IntersectionObserver" in window) {
      const demoObserver = new IntersectionObserver((entries) => {
        const isDemoVisible = entries.some((entry) => entry.isIntersecting);
        document.body.classList.toggle("demo-active", isDemoVisible);
      }, { rootMargin: "-20% 0px -10% 0px", threshold: 0.01 });

      demoObserver.observe(demoSection);
    }

    newsletterForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = newsletterForm.querySelector("button[type='submit']");
      const formData = new FormData(newsletterForm);
      const payload = Object.fromEntries(formData.entries());
      payload.pageUrl = window.location.href;

      newsletterFormStatus.textContent = "Subscribing...";
      newsletterFormStatus.className = "form-status";
      submitButton.disabled = true;

      try {
        const response = await fetch("/api/newsletter-subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result.error || "We could not subscribe that email.");
        }

        newsletterForm.reset();
        newsletterFormStatus.textContent = "Subscribed. Check your inbox for future notes.";
        newsletterFormStatus.className = "form-status success";
      } catch (error) {
        newsletterFormStatus.textContent = error.message || "Something went wrong. Please try again in a moment.";
        newsletterFormStatus.className = "form-status error";
      } finally {
        submitButton.disabled = false;
      }
    });
  </script>
</SiteLayout>
