---
import { getCollection } from "astro:content";
import FaqList from "../../components/FaqList.astro";
import BeforeAfterBlock from "../../components/BeforeAfterBlock.astro";
import FitBlock from "../../components/FitBlock.astro";
import InstallablesBlock from "../../components/InstallablesBlock.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import WorkflowAuditCta from "../../components/WorkflowAuditCta.astro";
import WorkflowProofBlock from "../../components/WorkflowProofBlock.astro";
import WorkflowIntegrationsBlock from "../../components/WorkflowIntegrationsBlock.astro";
import ProductScreenshot from "../../components/ProductScreenshot.astro";
import { auditHref } from "../../lib/conversion";
import { absoluteUrl, byOrder, defaultSocialImage, type BlogPost } from "../../lib/site";
import { servicePages, serviceSchema, serviceUrl, type ServicePage } from "../../lib/services";
import { productScreenshotForPath } from "../../lib/productScreenshots";
import { workflowIntegrationsForPath, workflowProofForPath } from "../../lib/workflowProof";
import "../../styles/service.css";

export async function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServicePage;
}

const { service } = Astro.props;
const posts = byOrder(await getCollection("blog"));
const relatedPosts = service.relatedPosts
  .map((slug) => posts.find((post) => post.data.slug === slug))
  .filter(Boolean) as BlogPost[];
const canonical = absoluteUrl(serviceUrl(service));
const auditUrl = auditHref(service.slug, "service");
const productScreenshot = productScreenshotForPath(`/services/${service.slug}/`);
const workflowProof = workflowProofForPath(`/services/${service.slug}/`);
const workflowIntegrations = workflowIntegrationsForPath(`/services/${service.slug}/`);
---

<SiteLayout
  title={`${service.seoTitle} | EMC2Ops`}
  description={service.description}
  canonical={canonical}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt={`${service.title} from EMC2Ops.`}
  schema={serviceSchema(service)}
  pageClass="service-page"
>
  <SiteHeader />
  <main>
    <section class="service-hero">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span>{service.eyebrow}
        </nav>
        <p class="eyebrow">{service.eyebrow}</p>
        <h1>{service.title}</h1>
        <p class="dek">{service.summary}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={auditUrl}>{service.auditCta.label}</a>
          <a class="btn btn-secondary" href="#workflow">See workflow</a>
        </div>
      </div>
    </section>

    <section class="product-proof-section">
      <div class="wrap">
        <ProductScreenshot screenshot={productScreenshot} />
      </div>
    </section>

    <section class="wrap split-section">
      <div>
        <h2>What this improves</h2>
        <p>{service.auditFocus}</p>
      </div>
      <div class="check-list">
        {service.outcomes.map((outcome) => <div><span>✓</span><p>{outcome}</p></div>)}
      </div>
    </section>

    <InstallablesBlock items={service.installables} intro="Each install is scoped around concrete triggers, captured fields, automations, writebacks, stop rules, and escalation paths." />

    {workflowIntegrations.length > 0 && <WorkflowIntegrationsBlock items={workflowIntegrations} />}

    <section id="workflow" class="wrap detail-section">
      <h2>Workflow to install</h2>
      <ol class="step-list">
        {service.workflow.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <WorkflowAuditCta
      title={service.auditCta.title}
      body={service.auditCta.body}
      href={auditUrl}
      label={service.auditCta.label}
      secondaryHref="#faq"
      secondaryLabel="Read FAQs"
    />

    <BeforeAfterBlock before={service.beforeAfter.before} after={service.beforeAfter.after} />

    {workflowProof && <WorkflowProofBlock proof={workflowProof} />}

    <section class="wrap detail-section">
      <h2>Metrics to track</h2>
      <div class="metric-list">{service.metrics.map((metric) => <span>{metric}</span>)}</div>
    </section>

    <FitBlock bestFit={service.bestFit} notFit={service.notFit} />

    <section class="wrap detail-section">
      <h2>Related use cases</h2>
      <div class="related-links">
        {service.relatedUseCases.map((link) => (
          <a href={link.href}>
            <strong>{link.label}</strong>
            <span>{link.description}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="faq" class="wrap detail-section">
      <FaqList faqs={service.faqs} />
    </section>

    {
      relatedPosts.length > 0 && (
        <section class="wrap detail-section">
          <h2>Related guides</h2>
          <div class="related-links">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.data.slug}/`}>
                <strong>{post.data.seoTitle || post.data.title}</strong>
                <span>{post.data.keyword}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <WorkflowAuditCta
      eyebrow="Next step"
      title={`Map your ${service.eyebrow.toLowerCase()} workflow`}
      body="Use the audit to confirm the trigger, data source, approval gates, CRM writebacks, and first measurable deployment."
      href={auditUrl}
      label={service.auditCta.label}
    />
  </main>
  <SiteFooter />
</SiteLayout>
