---
import AuditBookingSection from "../components/AuditBookingSection.astro";
import ClientReviews from "../components/ClientReviews.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { absoluteUrl, defaultSocialImage, standardPageSchema } from "../lib/site";
import { productScreenshotForPath } from "../lib/productScreenshots";
import "../styles/landing.css";

const title = "Book a 15-Minute Consultation | EMC2Ops";
const description = "Book a 15-minute EMC2Ops consultation for a tailored quote, workflow demo, or the right first automation for your property team.";
---

<SiteLayout
  title={title}
  description={description}
  canonical={absoluteUrl("/book-demo/")}
  image={absoluteUrl(defaultSocialImage)}
  imageAlt="EMC2Ops property management automation workflow for capturing after-hours leasing leads."
  schema={standardPageSchema({ path: "/book-demo/", name: "Book an EMC2Ops consultation", description, type: "ContactPage" })}
  author="EMC2Ops"
>
  <SiteHeader variant="blog" />

  <main>
    <section class="booking-page-hero">
      <div class="wrap">
        <div class="eyebrow">Quotes, demos, and workflow guidance</div>
        <h1>Tell us what you need. We’ll map the right next step.</h1>
        <p class="lead">Request a tailored quote, see a relevant workflow demo, or get a focused audit of the bottleneck slowing your property team down.</p>
      </div>
    </section>

    <section class="product-proof-section">
      <div class="wrap">
        <ProductScreenshot screenshot={productScreenshotForPath("/book-demo/")} />
      </div>
    </section>

    <ClientReviews />

    <AuditBookingSection />
  </main>

  <SiteFooter variant="blog" />
</SiteLayout>
