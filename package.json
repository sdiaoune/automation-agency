{
  "name": "automation-agency",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "start": "astro preview --host 0.0.0.0 --port 3000",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "generate:blog": "node scripts/generate-blog.mjs && npm run build",
    "seo:validate": "node scripts/seo-validate.mjs",
    "blog:list": "node scripts/blog-content.mjs --list",
    "blog:validate": "node scripts/blog-content.mjs",
    "post:blog:x": "node scripts/x-blog-post.mjs",
    "post:blog:social": "node scripts/x-blog-post.mjs",
    "post:x:growth": "node scripts/post-x-growth.mjs",
    "test:api": "node --test tests/api/*.test.js",
    "test:public": "playwright test tests/public-site.spec.js --browser=chromium",
    "test:dashboard": "node -e \"console.log('Legacy root dashboard.html route is intentionally outside the Astro public-site migration.')\"",
    "test": "npm run test:api && npm run test:public && npm run test:dashboard"
  },
  "devDependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@playwright/test": "^1.60.0",
    "astro": "^6.4.2"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
